$("owner").oninput=e=>{book.owner=e.target.value;updateCover();save()};
function bindColor(id,key){$(id).oninput=e=>{book[key]=e.target.value;applyAppearance();save()}}
bindColor("leather","leather");bindColor("paperColor","paper");bindColor("ruleColor","rule");bindColor("marginColor","margin");
