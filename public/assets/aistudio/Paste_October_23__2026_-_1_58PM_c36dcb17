/* Restore saved notebook. Try recovery copy if the main record is unavailable. */
try{
  let raw=localStorage.getItem(KEY);
  if(!raw){
    const recovery=localStorage.getItem(RECOVERY_KEY);
    if(recovery){
      raw=recovery;
      setStatus("Recovered saved copy");
    }
  }
  if(raw){
    const parsed=JSON.parse(raw);
    if(parsed.pages&&typeof parsed.pages==="object"){
      const normalizedPages={};
      Object.keys(parsed.pages).forEach(k=>{
        const n=Number(k);if(Number.isSafeInteger(n)&&n>0)normalizedPages[n]=normalizePage(parsed.pages[k]);
      });
      book={...clone(defaults),...parsed,pages:Object.keys(normalizedPages).length?normalizedPages:{"1":{html:"",drawings:[]}}};
      if(!Array.isArray(book.bookmarks))book.bookmarks=[];
      currentPage=Math.max(1,Number(book.currentPage)||1);
      if(!hasPage(currentPage))currentPage=Number(Object.keys(book.pages).sort((a,b)=>Number(a)-Number(b))[0]);
      $("welcome").hidden=true;
    }
  }
  $("bookTitle").value=book.title;$("owner").value=book.owner;
  $("leather").value=book.leather;$("paperColor").value=book.paper;
  $("ruleColor").value=book.rule;$("marginColor").value=book.margin;
  $("spacing").value=book.spacing;$("paperStyle").value=book.paperStyle;
  applyAppearance();updateCover();loadPage();setMode(book.mode||"type");
  cleanBookmarks();updateBookmarkButton();checkStorage();
}catch(e){
  console.error("Could not load notebook",e);
  setStatus("Could not load saved book");
}
})();
