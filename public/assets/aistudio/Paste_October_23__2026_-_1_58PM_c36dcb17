/* Export text and full-book backup */
function download(name,content,type){
  const blob=new Blob([content],{type});
  const url=URL.createObjectURL(blob);const a=document.createElement("a");
  a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);
}
$("exportText").onclick=()=>{
  saveNow();
  const output=Object.keys(book.pages).map(Number).sort((a,b)=>a-b).map(n=>{
    const d=document.createElement("div");d.innerHTML=book.pages[n].html||"";
    return"PAGE "+n+"\n"+d.innerText;
  }).join("\n\n------------------------\n\n");
  download("exercise-book.txt",output,"text/plain");
};
$("backup").onclick=()=>{
  flushBeforeLeaving();
  try{
    download("exercise-book-backup.json",JSON.stringify(book,null,2),"application/json");
    notify("Backup exported");
  }catch(_){notify("Backup failed")}
};
$("restore").onclick=()=>$("restoreFile").click();
$("restoreFile").onchange=e=>{
  const file=e.target.files[0];if(!file)return;
  const reader=new FileReader();
  reader.onload=()=>{
    try{
      const restored=JSON.parse(reader.result);
      if(!restored.pages||typeof restored.pages!=="object")throw Error("Invalid backup");
      const normalizedPages={};
      Object.keys(restored.pages).forEach(k=>{
        const n=Number(k);if(Number.isSafeInteger(n)&&n>0)normalizedPages[n]=normalizePage(restored.pages[k]);
      });
      if(!Object.keys(normalizedPages).length)normalizedPages[1]={html:"",drawings:[]};
      book={...clone(defaults),...restored,pages:normalizedPages};
      if(!Array.isArray(book.bookmarks))book.bookmarks=[];
      currentPage=Math.max(1,Number(book.currentPage)||1);
      if(!hasPage(currentPage))currentPage=Number(Object.keys(book.pages).sort((a,b)=>Number(a)-Number(b))[0]);
      historyByPage={};applyAppearance();updateCover();
      $("bookTitle").value=book.title;$("owner").value=book.owner;
      $("leather").value=book.leather;$("paperColor").value=book.paper;
      $("ruleColor").value=book.rule;$("marginColor").value=book.margin;
      $("spacing").value=book.spacing;$("paperStyle").value=book.paperStyle;
      loadPage();setMode(book.mode||"type");saveNow();updateBookmarkButton();
      notify("Backup restored");
    }catch(_){alert("This backup could not be opened.")}
    e.target.value="";
  };
  reader.readAsText(file);
};

/* Swipe left or right to turn pages. */
paper.addEventListener("touchstart",e=>{
  if(mode==="draw")return;const t=e.changedTouches[0];touchX=t.clientX;touchY=t.clientY;
},{passive:true});
paper.addEventListener("touchend",e=>{
  if(touchX===null||mode==="draw")return;
  const t=e.changedTouches[0],dx=t.clientX-touchX,dy=t.clientY-touchY;
  if(Math.abs(dx)>75&&Math.abs(dx)>Math.abs(dy)*1.4)changePage(dx<0?1:-1);
  touchX=null;touchY=null;
},{passive:true});

