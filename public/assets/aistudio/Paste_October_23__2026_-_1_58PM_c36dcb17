<script>
(() => {
"use strict";
const $=id=>document.getElementById(id);
const KEY="theOldBookPrototype_v2";
const RECOVERY_KEY=KEY+"_recovery";
const defaults={
  title:"The Old Book",owner:"Notes, ideas & sketches",
  leather:"#493022",paper:"#f4ebd5",rule:"#91b6d0",
  margin:"#c96e68",spacing:30,paperStyle:"ruled",
  currentPage:1,mode:"type",pages:{"1":{html:"",drawings:[]}},bookmarks:[]
};

let book=JSON.parse(JSON.stringify(defaults));
let currentPage=1,mode="type",tool="pen";
let drawingNow=false,activePointer=null,start=null;
let pageAnimating=false,saveTimer=null,focusFallback=false;
let historyByPage={},historyTimer=null,restoringHistory=false;
let touchX=null,touchY=null;

const writing=$("writing"),canvas=$("drawing"),ctx=canvas.getContext("2d"),paper=$("paper");

function normalizePage(p){
  if(!p||typeof p!=="object")return {html:"",drawings:[]};
  return {html:typeof p.html==="string"?p.html:"",drawings:Array.isArray(p.drawings)?p.drawings:[]};
}
function hasPage(n){return Object.prototype.hasOwnProperty.call(book.pages,String(n))}
function page(){
  if(!hasPage(currentPage))book.pages[currentPage]={html:"",drawings:[]};
  book.pages[currentPage]=normalizePage(book.pages[currentPage]);
  return book.pages[currentPage];
}
function setStatus(s){$("status").textContent="● "+s}
function notify(s){setStatus(s);setTimeout(()=>setStatus("Saved locally"),2200)}
function clone(value){return JSON.parse(JSON.stringify(value))}
function snapshot(){return {html:writing.innerHTML,drawings:clone(page().drawings)}}

function historyFor(n=currentPage){
  const key=String(n);
  if(!historyByPage[key]){
    const p=hasPage(n)?normalizePage(book.pages[key]):{html:"",drawings:[]};
    historyByPage[key]={items:[{html:p.html,drawings:clone(p.drawings)}],index:0};
  }
  return historyByPage[key];
}
function updateHistoryButtons(){
  const h=historyFor();
  $("undo").disabled=h.index<=0;
  $("redo").disabled=h.index>=h.items.length-1;
}
function commitHistory(){
  if(restoringHistory)return;
  const h=historyFor(),s=snapshot(),last=h.items[h.index];
  if(last&&last.html===s.html&&JSON.stringify(last.drawings)===JSON.stringify(s.drawings)){
    updateHistoryButtons();return;
  }
  h.items=h.items.slice(0,h.index+1);
  h.items.push(s);
  if(h.items.length>80)h.items.shift();
  h.index=h.items.length-1;
  updateHistoryButtons();
}
function scheduleHistory(){
  clearTimeout(historyTimer);
  historyTimer=setTimeout(()=>commitHistory(),300);
}
function restoreHistorySnapshot(s){
  restoringHistory=true;
  page().html=s.html;
  page().drawings=clone(s.drawings);
  writing.innerHTML=s.html;
  redraw();
  restoringHistory=false;
  save();
}
function undo(){
  clearTimeout(historyTimer);
  commitHistory();
  const h=historyFor();
  if(h.index<=0)return;
  h.index--;restoreHistorySnapshot(h.items[h.index]);updateHistoryButtons();
}
function redo(){
  clearTimeout(historyTimer);
  const h=historyFor();
  if(h.index>=h.items.length-1)return;
  h.index++;restoreHistorySnapshot(h.items[h.index]);updateHistoryButtons();
}

/* Debounced saving, plus a separate best-effort recovery copy. */
function saveNow(){
  clearTimeout(saveTimer);
  try{
    if(hasPage(currentPage))book.pages[currentPage].html=writing.innerHTML;
    book.currentPage=currentPage;book.mode=mode;
    const serialized=JSON.stringify(book);
    try{localStorage.setItem(RECOVERY_KEY,serialized)}catch(recoveryError){}
    localStorage.setItem(KEY,serialized);
    setStatus("Saved locally");
    checkStorage();
    return true;
  }catch(e){
    setStatus("Storage full — export a backup");
    warnStorage();
    return false;
  }
}
function save(){
  clearTimeout(saveTimer);
  setStatus("Saving…");
  saveTimer=setTimeout(saveNow,350);
}
let lastStorageWarning=0;
function warnStorage(){
  const now=Date.now();
  if(now-lastStorageWarning<12000)return;
  lastStorageWarning=now;
  setTimeout(()=>{
    alert("The book may be running out of browser storage. Export a backup soon. If saving fails, some recent changes may not be preserved.");
  },0);
}
async function checkStorage(){
  try{
    if(!navigator.storage||!navigator.storage.estimate)return;
    const e=await navigator.storage.estimate();
    if(e.quota&&e.usage/e.quota>.85){
      setStatus("Storage nearly full");
      warnStorage();
    }
  }catch(_){}
}
function flushBeforeLeaving(){
  clearTimeout(saveTimer);
  try{
    if(hasPage(currentPage))book.pages[currentPage].html=writing.innerHTML;
    book.currentPage=currentPage;book.mode=mode;
    const raw=JSON.stringify(book);
    try{localStorage.setItem(RECOVERY_KEY,raw)}catch(_){}
    localStorage.setItem(KEY,raw);
  }catch(_){setStatus("Save failed — export a backup")}
}

function applyAppearance(){
  const root=document.documentElement;
  root.style.setProperty("--leather",book.leather);
  root.style.setProperty("--paper",book.paper);
  root.style.setProperty("--rule",book.rule);
  root.style.setProperty("--margin",book.margin);
  root.style.setProperty("--lh",book.spacing+"px");
  if(book.paperStyle==="graph"){
    writing.style.backgroundImage="linear-gradient(to right,var(--rule) 1px,transparent 1px),linear-gradient(to bottom,var(--rule) 1px,transparent 1px)";
    writing.style.backgroundSize="22px 22px";
  }else if(book.paperStyle==="dotted"){
    writing.style.backgroundImage="radial-gradient(circle,var(--rule) 1px,transparent 1.2px)";
    writing.style.backgroundSize="16px 16px";
  }else if(book.paperStyle==="blank"){
    writing.style.backgroundImage="none";writing.style.backgroundSize="auto";
  }else{
    writing.style.backgroundImage="repeating-linear-gradient(to bottom,transparent 0,transparent calc(var(--lh) - 1px),var(--rule) calc(var(--lh) - 1px),var(--rule) var(--lh))";
    writing.style.backgroundSize="auto";
  }
}
function updateCover(){
  const title=book.title||"The Old Book";
  $("topTitle").textContent=title;$("coverTitle").textContent=title;
  $("coverSubtitle").textContent=book.owner||"A book of your own";
}
function updatePageLabels(){
  $("pageNumber").textContent=currentPage;
  const nums=Object.keys(book.pages).map(Number).filter(Number.isFinite);
  $("pageCount").textContent="Page "+currentPage+" · "+nums.length+" saved";
  $("prev").disabled=pageAnimating||currentPage<=1;
  $("next").disabled=pageAnimating;
}
function loadPage(){
  book.pages[currentPage]=normalizePage(book.pages[currentPage]);
  writing.innerHTML=page().html||"";
  writing.scrollTop=0;
  updatePageLabels();resizeCanvas();redraw();
  historyFor(currentPage);updateHistoryButtons();save();
}
function resizeCanvas(){
  const rect=paper.getBoundingClientRect();
  if(!rect.width||!rect.height)return;
  const dpr=Math.max(1,Math.min(2,window.devicePixelRatio||1));
  canvas.width=Math.round(rect.width*dpr);canvas.height=Math.round(rect.height*dpr);
  canvas.style.width=rect.width+"px";canvas.style.height=rect.height+"px";
  ctx.setTransform(dpr,0,0,dpr,0,0);redraw();
}
function shapes(){return page().drawings}
function drawShape(s){
  ctx.save();ctx.lineWidth=s.size||3;ctx.lineCap="round";ctx.lineJoin="round";
  ctx.strokeStyle=s.color||"#243f61";
  if(s.tool==="eraser")ctx.globalCompositeOperation="destination-out";
  ctx.beginPath();
  if(s.tool==="pen"||s.tool==="eraser"){
    if(!s.points?.length){ctx.restore();return}
    ctx.moveTo(s.points[0].x,s.points[0].y);
    for(let i=1;i<s.points.length;i++)ctx.lineTo(s.points[i].x,s.points[i].y);
    if(s.points.length===1)ctx.lineTo(s.points[0].x+.1,s.points[0].y+.1);
  }else{
    const a=s.start,b=s.end;
    if(!a||!b){ctx.restore();return}
    if(s.tool==="line"){ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y)}
    else if(s.tool==="circle")ctx.ellipse((a.x+b.x)/2,(a.y+b.y)/2,Math.abs(b.x-a.x)/2,Math.abs(b.y-a.y)/2,0,0,Math.PI*2);
    else if(s.tool==="triangle"){ctx.moveTo((a.x+b.x)/2,a.y);ctx.lineTo(b.x,b.y);ctx.lineTo(a.x,b.y);ctx.closePath()}
    else if(s.tool==="quad")ctx.rect(Math.min(a.x,b.x),Math.min(a.y,b.y),Math.abs(b.x-a.x),Math.abs(b.y-a.y));
  }
  ctx.stroke();ctx.restore();
}
function redraw(){
  if(!ctx||!canvas.width)return;
  const r=paper.getBoundingClientRect(),dpr=Math.max(1,Math.min(2,window.devicePixelRatio||1));
  ctx.setTransform(dpr,0,0,dpr,0,0);ctx.clearRect(0,0,r.width,r.height);
  shapes().forEach(drawShape);
}

/* Place the caret at the actual tapped position where supported. */
function getCaretAtPoint(x,y){
  if(document.caretPositionFromPoint){
    const p=document.caretPositionFromPoint(x,y);
    if(p){const range=document.createRange();range.setStart(p.offsetNode,p.offset);range.collapse(true);return range}
  }
  if(document.caretRangeFromPoint)return document.caretRangeFromPoint(x,y);
  return null;
}
function setCaret(range){
  const sel=window.getSelection();if(!sel)return;sel.removeAllRanges();sel.addRange(range);
}
function rangeTouchesText(range){
  if(!range)return false;
  const node=range.startContainer;
  return node.nodeType===Node.TEXT_NODE&&node.textContent.length>0;
}
function ensureBlankLineCaret(clientX,clientY){
  const r=paper.getBoundingClientRect(),lh=Number(book.spacing)||30,top=30;
  const targetLine=Math.max(0,Math.floor((clientY-r.top-top)/lh));
  const contentX=Math.max(0,clientX-r.left-48),charWidth=9.9;
  const targetColumn=Math.max(0,Math.floor(contentX/charWidth));
  let lines=writing.innerText.replace(/\r/g,"").split("\n");
  while(lines.length<=targetLine)lines.push("");
  if(lines[targetLine].length<targetColumn)lines[targetLine]+=" ".repeat(targetColumn-lines[targetLine].length);
  writing.textContent=lines.join("\n");
  const walker=document.createTreeWalker(writing,NodeFilter.SHOW_TEXT);
  let node,offset=0;
  const wanted=lines.slice(0,targetLine).join("\n").length+(targetLine>0?1:0)+Math.min(targetColumn,lines[targetLine].length);
  while((node=walker.nextNode())){
    const len=node.textContent.length;
    if(wanted<=offset+len){
      const range=document.createRange();range.setStart(node,Math.min(wanted-offset,len));range.collapse(true);
      setCaret(range);scheduleHistory();save();return;
    }
    offset+=len;
  }
  const range=document.createRange();range.selectNodeContents(writing);range.collapse(false);setCaret(range);scheduleHistory();save();
}
writing.addEventListener("pointerdown",e=>{
  if(mode!=="type"||pageAnimating)return;
  if(e.pointerType==="mouse"&&e.button!==0)return;
  const nativeRange=getCaretAtPoint(e.clientX,e.clientY);
  if(nativeRange&&rangeTouchesText(nativeRange))return;
  e.preventDefault();writing.focus({preventScroll:true});ensureBlankLineCaret(e.clientX,e.clientY);
});
writing.addEventListener("input",()=>{scheduleHistory();save()});
writing.addEventListener("keydown",e=>{
  if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==="z"){
    e.preventDefault();if(e.shiftKey)redo();else undo();return;
  }
  if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==="y"){e.preventDefault();redo();return}
  if(e.key==="Tab"){e.preventDefault();document.execCommand("insertText",false,"    ");scheduleHistory();save()}
});

/* Page switching: only navigation creates a new page when explicitly moving forward. */
function changePage(delta){
  if(pageAnimating)return;
  const next=currentPage+delta;
  if(next<1)return;
  clearTimeout(historyTimer);commitHistory();saveNow();
  if(delta<0&&!hasPage(next))return;
  if(delta>0&&!hasPage(next))book.pages[next]={html:"",drawings:[]};
  pageAnimating=true;updatePageLabels();
  const layer=$("turnLayer");
  layer.className="turn-layer active "+(delta>0?"forward":"backward");
  setTimeout(()=>{
    currentPage=next;
    layer.className="turn-layer";pageAnimating=false;
    loadPage();updatePageLabels();
  },820);
}
function jumpToPage(n){
  if(!Number.isSafeInteger(n)||n<1||!hasPage(n)){
    $("jumpError").textContent="Page does not exist.";
    $("jumpError").hidden=false;return false;
  }
  clearTimeout(historyTimer);commitHistory();saveNow();
  currentPage=n;loadPage();$("jumpDialog").hidden=true;$("jumpError").hidden=true;
  notify("Opened page "+n);return true;
}
$("jumpBtn").onclick=()=>{
  $("jumpNumber").value=String(currentPage);
  $("jumpError").hidden=true;$("jumpDialog").hidden=false;
  $("jumpNumber").focus();
};
$("jumpForm").addEventListener("submit",e=>{
  e.preventDefault();const raw=$("jumpNumber").value.trim();
  if(!/^[1-9]\d*$/.test(raw)){ $("jumpError").textContent="Enter a valid page number."; $("jumpError").hidden=false;return }
  jumpToPage(Number(raw));
});
$("cancelJump").onclick=()=>$("jumpDialog").hidden=true;

/* Page management: insertion shifts later page numbers; duplication copies both content and drawings. */
function renumberPagesForInsert(at){
  const updated={};
  Object.keys(book.pages).map(Number).sort((a,b)=>b-a).forEach(n=>{
    updated[n>=at?n+1:n]=book.pages[n];
  });
  book.pages=updated;
}
$("insertPage").onclick=()=>{
  clearTimeout(historyTimer);commitHistory();saveNow();
  const at=currentPage+1;
  renumberPagesForInsert(at);
  book.pages[at]={html:"",drawings:[]};
  currentPage=at;loadPage();notify("Page inserted");
};
$("duplicatePage").onclick=()=>{
  clearTimeout(historyTimer);commitHistory();saveNow();
  const copy=clone(page()),at=currentPage+1;
  renumberPagesForInsert(at);
  book.pages[at]=copy;currentPage=at;loadPage();notify("Page duplicated");
};
$("clearPage").onclick=()=>{
  if(!confirm("Clear all typed text and drawings on page "+currentPage+"? This cannot be undone after you leave this page."))return;
  commitHistory();
  page().html="";page().drawings=[];
  writing.innerHTML="";commitHistory();redraw();saveNow();updateHistoryButtons();
  notify("Page cleared");
};

/* Bookmarks */
function cleanBookmarks(){
  if(!Array.isArray(book.bookmarks))book.bookmarks=[];
  book.bookmarks=[...new Set(book.bookmarks.map(Number).filter(n=>Number.isSafeInteger(n)&&n>0&&hasPage(n)))].sort((a,b)=>a-b);
}
function toggleBookmark(){
  cleanBookmarks();
  const i=book.bookmarks.indexOf(currentPage);
  if(i>=0){book.bookmarks.splice(i,1);notify("Bookmark removed")}
  else{book.bookmarks.push(currentPage);book.bookmarks.sort((a,b)=>a-b);notify("Page bookmarked")}
  save();updateBookmarkButton();
}
function updateBookmarkButton(){
  cleanBookmarks();
  $("bookmarkBtn").textContent=book.bookmarks.includes(currentPage)?"★ Bookmarked":"☆ Bookmark";
}
function renderBookmarks(){
  cleanBookmarks();const list=$("bookmarkList");list.innerHTML="";
  $("noBookmarks").hidden=book.bookmarks.length>0;
  book.bookmarks.forEach(n=>{
    const row=document.createElement("div");row.className="bookmark-entry";
    const go=document.createElement("button");go.textContent="⚑ Page "+n;go.onclick=()=>{jumpToPage(n)};
    const remove=document.createElement("button");remove.textContent="×";remove.className="remove-bookmark";remove.title="Remove bookmark";
    remove.onclick=()=>{book.bookmarks=book.bookmarks.filter(x=>x!==n);save();renderBookmarks();updateBookmarkButton()};
    row.append(go,remove);list.appendChild(row);
  });
}
$("bookmarkBtn").onclick=toggleBookmark;
$("bookmarksBtn").onclick=()=>{renderBookmarks();$("bookmarksDialog").hidden=false};
$("closeBookmarks").onclick=()=>$("bookmarksDialog").hidden=true;

/* Drawing tools. History records completed drawing actions. */
function point(e){const r=canvas.getBoundingClientRect();return{x:e.clientX-r.left,y:e.clientY-r.top}}
canvas.addEventListener("pointerdown",e=>{
  if(mode!=="draw"||pageAnimating)return;
  e.preventDefault();
  try{canvas.setPointerCapture(e.pointerId)}catch(_){}
  activePointer=e.pointerId;drawingNow=true;start=point(e);
  shapes().push({tool,size:Number($("drawSize").value),color:$("drawColor").value,points:[start],start,end:start});
  redraw();
});
canvas.addEventListener("pointermove",e=>{
  if(!drawingNow||e.pointerId!==activePointer)return;
  e.preventDefault();const p=point(e),s=shapes()[shapes().length-1];if(!s)return;
  if(tool==="pen"||tool==="eraser")s.points.push(p);else s.end=p;
  redraw();
});
function endDrawing(e){
  if(!drawingNow||e.pointerId!==activePointer)return;
  const s=shapes()[shapes().length-1];
  if(s&&tool!=="pen"&&tool!=="eraser")s.end=point(e);
  drawingNow=false;activePointer=null;start=null;
  redraw();commitHistory();save();
}
canvas.addEventListener("pointerup",endDrawing);
canvas.addEventListener("pointercancel",endDrawing);

document.querySelectorAll("[data-tool]").forEach(b=>{
  b.onclick=()=>{
    tool=b.dataset.tool;
    document.querySelectorAll("[data-tool]").forEach(x=>x.classList.toggle("active",x===b));
  };
});
$("undo").onclick=undo;$("redo").onclick=redo;
$("clear").onclick=()=>{
  if(!shapes().length)return;
  if(confirm("Clear all drawings on this page?")){
    page().drawings=[];redraw();commitHistory();save();
  }
};
$("done").onclick=()=>setMode("type");
$("typeMode").onclick=()=>setMode("type");
$("drawMode").onclick=()=>setMode("draw");
$("prev").onclick=()=>changePage(-1);
$("next").onclick=()=>changePage(1);

function setMode(next){
  mode=next;const drawing=mode==="draw";
  writing.contentEditable=String(!drawing);
  writing.style.pointerEvents=drawing?"none":"auto";
  canvas.style.pointerEvents=drawing?"auto":"none";
  $("toolbar").hidden=!drawing;
  $("typeMode").classList.toggle("active",!drawing);
  $("drawMode").classList.toggle("active",drawing);
  $("help").textContent=drawing
    ?"Choose a tool and drag on the paper · Undo and redo include drawings"
    :"Tap where you want to write · Text and drawings save automatically";
  save();
}

/* Cover and first-time setup */
